#let content-to-string(content) = {
	if content.has("text") {
		content.text
	} else if content.has("children") {
		content.children.map(content-to-string).join("")
	} else if content.has("body") {
		content-to-string(content.body)
	} else if content == [ ] {
		" "
	}
}

/* Logos */
#let orcidSvg = ```<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 24 24"> <path fill="#AECD54" d="M21.8,12c0,5.4-4.4,9.8-9.8,9.8S2.2,17.4,2.2,12S6.6,2.2,12,2.2S21.8,6.6,21.8,12z M8.2,5.8c-0.4,0-0.8,0.3-0.8,0.8s0.3,0.8,0.8,0.8S9,7,9,6.6S8.7,5.8,8.2,5.8z M10.5,15.4h1.2v-6c0,0-0.5,0,1.8,0s3.3,1.4,3.3,3s-1.5,3-3.3,3s-1.9,0-1.9,0H10.5v1.1H9V8.3H7.7v8.2h2.9c0,0-0.3,0,3,0s4.5-2.2,4.5-4.1s-1.2-4.1-4.3-4.1s-3.2,0-3.2,0L10.5,15.4z"/></svg>```.text
#let mailSvg = ```<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 199.2 199.3" xmlns:v="https://vecta.io/nano"><path d="M99.6 199.3c54.5 0 99.6-45.1 99.6-99.6C199.2 45.3 154 .1 99.5.1 45.1.1 0 45.3 0 99.7c0 54.5 45.2 99.6 99.6 99.6z" opacity=".49" fill="#404040" fill-opacity=".25"/><path d="M99.6 105c-1.5 0-3.1-.6-4.6-2L45.4 59.3c2.7-1.7 5.7-2.3 9.9-2.3H144c4 0 7 .8 9.9 2.4L104.2 103c-1.5 1.4-3 2-4.6 2zM41 134.4c-.9-2-1.4-4.1-1.4-7.2V72.3c0-3.2.7-5.8 1.2-6.8l36.6 32.3L41 134.4zm12.8 8.1c-3.5 0-6.2-.8-8.2-2.1l37.7-37.6 7.1 6.3c2.8 2.5 6.1 3.8 9.2 3.8s6.3-1.3 9.3-3.8l7-6.3 37.7 37.6c-2 1.2-4.7 2.1-8.2 2.1H53.8zm104.5-8.1l-36.6-36.6 36.7-32.2c.5 1 1.1 3.5 1.1 6.7v54.9c0 3-.4 5.2-1.2 7.2z" fill="#7e8c7b"/></svg>```.text

#let conf(
	title: none,
	subtitle: none,
	running-head: none,
	titlepage: false,
	titlepage-background: none,
	toc: none,
	authors: (),
	affiliations: (),
	keywords: (),
	date: none,
	abstract-title: none,
	abstract: none,
	thanks: none,
	cols: 1,
	margin: (x: 1.75cm, y: 2cm),
	paper: "a4",
	lang: "en",
	region: "GB",
	font: none,
	fontsize: 12pt,
	mathfont: none,
	codefont: none,
	linestretch: 1.2em,
	sectionnumbering: none,
	linkcolor: none,
	citecolor: none,
	filecolor: none,
	pagenumbering: "1",
	doc,
) = {
	if titlepage-background != none { titlepage = true} else { titlepage = false }
	set document(
		title: title,
		keywords: keywords,
	)
	set document(
			author: authors.map(author => content-to-string(author.name)).join(", ", last: " & "),
	) if authors != none and authors != ()
	set page(
		paper: paper,
		margin: margin,
		numbering: pagenumbering,
		columns: cols,
		background: context {
			if titlepage { image(titlepage-background, fit: "stretch") } else { none }
		},
		header: context {
			if titlepage { none } else { align(right, text(size: 8pt, title)) }
		},
		footer: context {
			if titlepage { none } else { grid(columns: (1fr, 1fr),align(left, text(style: "italic", font: sans-font, size: 8pt, running-head)),align(right, [#context counter(page).display()]))}
		},
	)
	set par(
		justify: true,
		leading: linestretch * 0.65em,
		spacing: linestretch * 1.1em,
		justification-limits: (tracking: (min: -0.01em, max: 0.02em),)
	)
	set text(lang: lang,
					 region: region,
					 size: fontsize)
	set text(font: font) if font != none
	show math.equation: set text(font: mathfont) if mathfont != none
	show raw: set text(font: codefont) if codefont != none

	set heading(numbering: sectionnumbering)

	show link: set text(fill: rgb(content-to-string(linkcolor))) if linkcolor != none
	show ref: set text(fill: rgb(content-to-string(citecolor))) if citecolor != none
	show link: this => {
		if filecolor != none and type(this.dest) == label {
			text(this, fill: rgb(content-to-string(filecolor)))
		} else {
			text(this)
		}
	}

	if title != none {
		place(top, float: true, scope: "parent", clearance: 4mm, block(below: 1em, width: 100%)[
			#if title != none {
				align(center, block[
						#text(font: heading-font, weight: "bold", size: 2em, hyphenate: false)[#title #if thanks != none {
								footnote(thanks, numbering: "*")
								counter(footnote).update(n => n - 1)
							}]
						#(
							if subtitle != none {
								parbreak()
								text(weight: "bold", size: 1.25em, hyphenate: false)[#subtitle]
							}
						 )])
			}

	#if authors != none and authors != [] {
		let count = authors.len()
		let ncols = calc.min(count, 3)
		grid(
			columns: (1fr,) * ncols,
			row-gutter: 1.5em,
			column-gutter: 1.25em,
			..authors.map(author => align(center)[
						#strong[#emph[#author.name]]
						#if "affiliation" in author and author.affiliation != () [#super[#author.affiliation]]
						#if "email" in author and author.email != () [#link("mailto://" + content-to-string(author.email))[#box(height: 1.1em, baseline: 13.5%)[#image(bytes(mailSvg))]]]
						#if "orcid" in author and author.orcid != () [#link("https://orcid.org/" + content-to-string(author.orcid))[#box(height: 1.1em, baseline: 13.5%)[#image(bytes(orcidSvg))]]]
					]
			)
		)
	}

	#if date != none {
		align(center)[#block(inset: 1em)[
			#date
		]]
	}

	#if affiliations.len() > 0 {
		set text(size: 9pt)
		block(width: 100%, stroke: none, inset: (top: 20pt, bottom: 20pt), {
			text(size: 1.2em, style: "italic", weight: "bold", "Affiliations: ")
			parbreak()
			affiliations.map(affiliation => {
				strong([#affiliation.id — ])
				affiliation.name 
				parbreak()
			}).join("")
		})
	}

	#if abstract != none {
			block(inset: 2em)[
				#text(weight: "semibold")[#abstract-title] #h(1em) #abstract
			]
		}
		])
	}

	if (keywords.len() > 0) {
		text(size: 9pt, {
			h(2em)
			text(weight: "semibold", "Keywords")
			h(8pt)
			keywords.join(", ")
		})
	}
	v(10pt)

	if titlepage { 
		set page(
		background: none,
		fill: none,
		header: align(right, text(style: "italic", font: sans-font, size: 8pt, title)),
		footer: grid(columns: (1fr, 1fr),align(left, text(style: "italic", font: sans-font, size: 8pt, running-head)),align(right, [#context counter(page).display()]))
		)
		if title != none or subtitle != none or authors != () or affiliations != () or keywords != () or toc != none { counter(page).update(1) }
		if cols == 1 {
			doc
		} else {
			columns(cols, doc)
		}
	} else {
		if cols == 1 {
			doc
		} else {
			columns(cols, doc)
		}
	}
}
